rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a verified ALU email (student or staff).
    function isAluUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@(alustudent|alueducation)[.]com$');
    }

    // Staff have an @alueducation.com email, or were added by an admin as a
    // document in the `staff` collection (Firebase console only).
    function isStaff() {
      return isAluUser()
        && (request.auth.token.email.matches('.*@alueducation[.]com$')
            || exists(/databases/$(database)/documents/staff/$(request.auth.uid)));
    }

    function isOwner(report) {
      return report.reporterId == request.auth.uid;
    }

    // Signed in with an ALU email, verified or not yet.
    function isAluAccount() {
      return request.auth != null
        && request.auth.token.email.matches('.*@(alustudent|alueducation)[.]com$');
    }

    // Profiles: each person manages their own (saved at registration,
    // before the email is verified); staff can look people up.
    match /users/{uid} {
      allow read: if (isAluAccount() && request.auth.uid == uid) || isStaff();
      allow create, update: if isAluAccount() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAluUser();

      // New reports must belong to the sender, start as "submitted", have
      // no supporters yet, and leave the priority for staff to set.
      allow create: if isAluUser()
        && isOwner(request.resource.data)
        && request.resource.data.status == 'submitted'
        && !('priority' in request.resource.data)
        && request.resource.data.get('supporters', []).size() == 0;

      // Staff handle status, team and priority changes.
      allow update: if isStaff()
        && request.resource.data.reporterId == resource.data.reporterId;

      // Students may edit the form fields of their own report while it is
      // still "submitted".
      allow update: if isAluUser()
        && isOwner(resource.data)
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'category', 'building',
                       'landmark', 'photoUrl', 'updatedAt']);

      // "Me too": any student may add or remove only their own UID on an
      // open report, and change nothing else.
      allow update: if isAluUser()
        && resource.data.status != 'resolved'
        && isOwnSupportToggle();

      allow delete: if isAluUser()
        && isOwner(resource.data)
        && resource.data.status == 'submitted';
    }

    function isOwnSupportToggle() {
      let before = resource.data.get('supporters', []).toSet();
      let after = request.resource.data.get('supporters', []).toSet();
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['supporters'])
        && after.difference(before).union(before.difference(after))
             .hasOnly([request.auth.uid]);
    }

    // Campus announcements: everyone can read them; staff post and remove
    // them. They are never edited, only replaced.
    match /announcements/{announcementId} {
      allow read: if isAluUser();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(
             ['title', 'message', 'building', 'postedBy', 'createdAt', 'expiresAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.expiresAt is timestamp;
      allow delete: if isStaff();
      allow update: if false;
    }

    // Staff list: people can check their own entry; only admins (via the
    // Firebase console) can add or remove staff.
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
